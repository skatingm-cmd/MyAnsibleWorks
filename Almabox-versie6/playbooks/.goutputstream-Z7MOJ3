---
- name: Validate inventory and prepare systems
  hosts: all
  become: true
  gather_facts: true

  pre_tasks:
    - name: Ensure required inventory groups exist
      ansible.builtin.assert:
        that:
          - "'controlplane' in groups"
          - "'workers' in groups"
          - groups['controlplane'] | length > 0
          - groups['workers'] | length > 0
        fail_msg: >
          Inventory must define non-empty 'controlplane' and 'workers' groups.
        success_msg: "Inventory layout validated."

  roles:
    - role: common
      tags: [common, system]

# --------------------------------------------------

- name: Install Containerd
  hosts: all
  become: true
  gather_facts: true

  roles:
    - role: containerd
      tags: [containerd, system]

# --------------------------------------------------

- name: Install IPVS
  hosts: all
  become: true
  gather_facts: true

  roles:
    - role: ipvs
      tags: [ipvs, system]

# --------------------------------------------------

- name: Install Kubernetes
  hosts: all
  become: true
  gather_facts: false

  roles:
    - role: k8sinstall
      tags: [k8sinstall, kubernetes]
    - role: k8spreflight
      tags: [k8spreflight, kubernetes]
